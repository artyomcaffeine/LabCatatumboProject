---
/* Una sola plantilla para todas las páginas Markdown de src/content/pages: banner, foto opcional, texto. */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import TourList from '../../components/TourList.astro';
import Today from '../../components/Today.astro';
import { langOf, slugOf, type Page } from '../../lib/pages';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { lang: langOf(page), slug: slugOf(page) }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const lang = langOf(page);
const { title, description, key, photo, photoAlt } = page.data;
const { Content } = await render(page);
---
<Base lang={lang} title={`${title} · Catatumbo`} description={description} page={key}>
  <PageHeader lang={lang} title={title} description={description} />
  {photo && (
    <figure class="ct-photo">
      <Image src={photo} alt={photoAlt ?? ''} widths={[640, 1024, 1440, 1920]} sizes="100vw" format="webp" />
      <figcaption class="mono-credit"><a href="https://commons.wikimedia.org/wiki/User:Fernando_Flores" target="_blank" rel="noreferrer">Fernando Flores · Wikimedia Commons · CC BY-SA 2.0</a></figcaption>
    </figure>
  )}
  {key === 'today' && <Today lang={lang} />}
  <article class="ct-section prose">
    <Content />
    {key === 'tours' && <TourList lang={lang} />}
  </article>
</Base>
